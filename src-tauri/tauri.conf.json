{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Garmin Trainer",
  "version": "0.1.3",
  "identifier": "com.codexa.garmin-trainer.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "setup",
        "title": "Garmin Trainer — Settings",
        "width": 900,
        "height": 820
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self' ipc: http://ipc.localhost",
      "capabilities": ["setup"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": { "resources/": "resources/" },
    "macOS": { "minimumSystemVersion": "12.0" },
    "windows": {
      "webviewInstallMode": { "type": "skip" },
      "allowDowngrades": false,
      "nsis": {
        "installMode": "currentUser",
        "template": "windows/installer.nsi",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  }
}
