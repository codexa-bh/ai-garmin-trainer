{
  "name": "ai-garmin-trainer",
  "scripts": {
    "desktop:resources": "npm run build && npm run desktop:assemble",
    "desktop:assemble": "node scripts/desktop/assemble.mjs",
    "smoke:quick": "python3 scripts/desktop/quick_smoke.py",
    "desktop:build": "npm run desktop:resources && tauri build --target aarch64-apple-darwin --bundles app --no-sign --no-binary-patching --ci",
    "desktop:dev": "npm run desktop:resources && tauri dev",
    "smoke:native": "python3 scripts/desktop/native_smoke.py",
    "smoke:settings": "python3 scripts/desktop/settings_smoke.py",
    "smoke:release": "python3 scripts/desktop/release_smoke.py",
    "smoke:ordinary": "python3 scripts/desktop/ordinary_smoke.py",
    "smoke:tables": "python3 scripts/desktop/table_smoke.py",
    "smoke:test": "python3 -m unittest discover -s scripts/desktop -p '*_test.py' && python3 -m unittest discover -s scripts/ci -p '*_test.py'",
    "ci:seed": "tsx scripts/ci/seed.ts",
    "desktop:test:native": "cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "doctor": "tsx scripts/doctor.ts",
    "garmin:auth": "tsx scripts/garmin-auth.ts",
    "db:status": "tsx scripts/db-status.ts",
    "build": "next build",
    "lint": "eslint . --max-warnings=0",
    "architecture": "node scripts/architecture-check.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run && npm run smoke:test",
    "format": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "deps:evidence": "tsx scripts/dependency-evidence.ts",
    "eval:reliability": "tsx scripts/evaluate-coaching.ts",
    "validate": "npm run format && npm run lint && npm run architecture && npm run knip && npm run typecheck && npm run test && npm run build",
    "validate:ci": "npm run format && npm run lint && npm run architecture && npm run knip && npm run typecheck && npm run test",
    "backfill:activity-effort": "tsx scripts/backfill-activity-effort.ts",
    "knip": "knip"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "3.0.11",
    "@ai-sdk/openai": "4.0.15",
    "@next/env": "16.4.3",
    "ai": "7.0.29",
    "better-sqlite3": "12.11.1",
    "drizzle-orm": "0.45.2",
    "next": "16.4.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-is": "19.2.7",
    "recharts": "3.10.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.2",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.3",
    "eslint-plugin-sonarjs": "4.2.1",
    "globals": "16.5.0",
    "jsdom": "29.1.1",
    "knip": "6.37.0",
    "prettier": "3.9.5",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "private": true,
  "overrides": {
    "postcss": "8.5.32"
  }
}
