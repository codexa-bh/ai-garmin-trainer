    {
      "columns": [
        {
          "name": "garmin_id",
          "note": "Hidden required argument: function('verified-id') or WHERE garmin_id='verified-id'; selectable explicitly (not in SELECT *). Numeric safe integer IDs also accepted. Never infer availability from discovery rowCount.",
          "type": "text",
        },
        {
          "name": "window_index",
          "note": "zero-based consecutive section index",
          "type": "integer",
        },
        {
          "name": "start_elapsed_sec",
          "note": "timestamp-relative to first parseable stream timestamp, not stored sample indexes",
          "nullable": true,
          "type": "real",
          "unit": "seconds",
        },
        {
          "name": "end_elapsed_sec",
          "nullable": true,
          "type": "real",
          "unit": "seconds",
        },
        {
          "name": "calculated_grade_pct",
          "note": "100 * altitude change / recorded cumulative-distance change; approximate, smoothed section grade, not peak instantaneous slope",
          "nullable": true,
          "type": "real",
          "unit": "%",
        },
        {
          "name": "grade_method",
          "note": "altitude_distance_sections_v1",
          "type": "text",
        },
        {
          "name": "target_window_sec",
          "type": "integer",
          "unit": "seconds",
        },
        {
          "name": "support_seconds",
          "nullable": true,
          "type": "real",
          "unit": "seconds",
        },
        {
          "name": "support_distance_meters",
          "nullable": true,
          "type": "real",
          "unit": "meters",
        },
        {
          "name": "sample_count",
          "note": "shared endpoints counted in both sections; input_limit counts only capped input",
          "type": "integer",
        },
        {
          "name": "usable_sample_count",
          "note": "finite timestamp/altitude/nonnegative distance; not a continuity certificate",
          "type": "integer",
        },
        {
          "name": "source_grade_sample_count",
          "note": "finite imported grade values, independent of calculated validity",
          "type": "integer",
        },
        {
          "name": "quality_status",
          "note": "available | no_stream | input_limit | invalid_timing | missing_values | sampling_gap | distance_reset | insufficient_time | insufficient_distance | nonfinite_result",
          "type": "text",
        },
      ],
      "dateRange": undefined,
      "description": "Read-time table-valued relation: activity_calculated_grade('verified-id'), or join activity_calculated_grade(a.garmin_id). REQUIRED: pass the activity ID as function argument OR WHERE garmin_id = 'verified-id'. Unconstrained queries fail, never mean unavailable. Discovery rowCount=0 is registration metadata only, NOT activity/window evidence. Approximate signed altitude/distance sections, NOT measured instantaneous gradient, dashboard centered readout, terrain or technicality. Timestamp-only timing (stored elapsed may be sample indexes); timezone-less Garmin calendar timestamps use relative clock arithmetic, never host timezone or absolute-time claims; mixed absolute/relative bases rejected; consecutive sections close at first sample >=180s, share endpoints, final short section allowed. Requires >=60s, >=3 complete samples, >=10m net distance, strictly increasing timestamps, adjacent gaps <=30s, nonnegative nondecreasing cumulative distance. Invalid sections return null with quality_status; no stream returns one unavailable sentinel. Coverage denominator is all returned sections: count(calculated_grade_pct)/count(*), not unique samples or activity distance. Aggregate with method and coverage. Max 100000 points/activity (excess yields input_limit null sentinel); max 32 invocations/query. Filter selected activities before calling; aggregate rather than dump windows.",
      "joins": [
        "activity a join activity_calculated_grade(a.garmin_id) g",
      ],
      "name": "activity_calculated_grade",
      "rowCount": 0,
    },
