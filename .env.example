# Local-only application URL and auth
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-long-random-local-secret
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
ALLOWED_GOOGLE_EMAILS=operator@example.com

# Local SQLite database
DATABASE_PATH=./data/trainer.sqlite

# Garmin connector
GARMIN_HISTORY_START_DATE=2024-01-01
GARMIN_MCP_COMMAND=uvx
GARMIN_MCP_ARGS=garmin-mcp@git+https://github.com/Taxuspt/garmin_mcp.git@2974244bfda1595b00836b3f942f579ec2d6f7d6
GARMIN_MCP_TOKEN_DIR=./.garmin-token

# AI provider selection
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=replace-with-openai-key
DEEPSEEK_API_KEY=replace-with-deepseek-key
DEEPSEEK_MODEL=deepseek-chat
