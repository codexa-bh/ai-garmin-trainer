# Local-only application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local SQLite database
DATABASE_PATH=./data/trainer.sqlite

# Garmin connector
GARMIN_HISTORY_START_DATE=2024-01-01
GARMIN_MCP_COMMAND=uvx
GARMIN_MCP_ARGS=--from git+https://github.com/Taxuspt/garmin_mcp.git@3610be6feed93088d85b0f35aba9d7d07c2505a7 --with mcp==1.28.1 garmin-mcp
# Required for Garmin operations; no default/fallback. Relative to app checkout cwd.
# Use an absolute durable private path when sharing this env across worktrees.
# This is a directory setting, never credential contents. See docs/garmin-auth.md.
GARMIN_MCP_TOKEN_DIR=./.garmin-token

# AI provider selection
# Default auto mode is DeepSeek-first and falls back to OpenAI when no valid DeepSeek key is configured.
# For local loopback chat, run `ollama pull qwen3.5:4b`, set AI_PROVIDER=ollama,
# and leave OLLAMA_BASE_URL on the OpenAI-compatible loopback /v1 endpoint.
AI_PROVIDER=auto
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=replace-with-openai-key
DEEPSEEK_API_KEY=replace-with-deepseek-key
DEEPSEEK_MODEL=deepseek-chat
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Local developer diagnostics. Disabled by default; when true, completed assistant
# turns persist bounded LLM/tool orchestration traces visible from Settings.
LLM_DEBUG_TRACES=false

# Embedded SQLite semantic memory.
# Vectors persist in DATABASE_PATH; no Qdrant/Docker/hosted vector account is required.
# Local no-paid semantic embeddings: run `ollama pull nomic-embed-text`, then set
# MEMORY_EMBEDDING_PROVIDER=ollama and MEMORY_EMBEDDING_MODEL=nomic-embed-text.
# Ollama is supported only on local loopback (default http://127.0.0.1:11434).
# OpenAI-compatible embedding calls may incur provider cost and use OPENAI_API_KEY.
# DeepSeek/OpenAI chat can be used for guarded memory extraction when configured; embeddings remain separate.
# When AI_PROVIDER=ollama, memory extraction does not send extraction prompts to Ollama chat;
# it uses configured DeepSeek/OpenAI if available, otherwise deterministic fallback.
# MEMORY_EXTRACTION_MODE=llm uses a non-Ollama chat extractor first, then deterministic fallback on failure.
# MEMORY_EXTRACTION_MODE=deterministic skips the model extractor; off disables post-answer ingestion.
MEMORY_ENABLED=false
MEMORY_EXTRACTION_MODE=llm
MEMORY_EXTRACTION_TIMEOUT_MS=3000
MEMORY_EMBEDDING_PROVIDER=openai
MEMORY_EMBEDDING_MODEL=text-embedding-3-small
MEMORY_EMBEDDING_BASE_URL=
MEMORY_EMBEDDING_DIMS=1536
MEMORY_TIMEOUT_MS=8000
